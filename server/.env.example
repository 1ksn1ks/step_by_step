# Cloudflare R2 — copy to .env and fill in (the real .env is gitignored).
#
# 1. R2 dashboard → create a bucket (e.g. hedera-media)
# 2. bucket → Manage Public Access → enable (gives the https://<bucket>.r2.pub URL)
# 3. R2 → Manage R2 API Tokens → create token (S3 API credentials)
# 4. account ID: Cloudflare dashboard → Overview (16 hex chars)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hedera-media
R2_PUBLIC_BASE_URL=https://hedera-media.r2.pub
