# Cloudflare R2 — copy to .env and fill in (the real .env is gitignored).
#
# 1. R2 dashboard → create a bucket (e.g. hedera-media)
# 2. bucket → Manage Public Access → enable (gives the https://<bucket>.r2.pub URL)
# 3. R2 → Manage R2 API Tokens → create token (S3 API credentials)
# 4. account ID: Cloudflare dashboard → Overview (16 hex chars)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hedera-media
R2_PUBLIC_BASE_URL=https://hedera-media.r2.pub

# Reverse-proxy hops that may set the client address. Railway in front of
# this process is 1. Use 0 to keep the socket address. Never paste a domain.
TRUST_PROXY=1

# Set to 1 only when Cloudflare strips a client-supplied CF-Connecting-IP
# before it reaches Node. Leave unset to ignore that header.
TRUST_CF_IP=

# Upload bodies buffered in memory at once. Further uploads get 503.
UPLOAD_MAX_CONCURRENT=4

# Uploads from one IP at once, so a few slow bodies cannot fill every slot.
UPLOAD_MAX_CONCURRENT_PER_IP=2

# Milliseconds a stalled upload body may sit idle before 408.
UPLOAD_BODY_TIMEOUT_MS=30000

# Per IP each minute on POST /api/upload, checked before Turnstile.
UPLOAD_REQUESTS_PER_MIN=30

# Rolling hour caps. Account cap applies only when the phone sent an account
# id, or when wallet upload auth is on and the token names an account.
UPLOAD_RATE_LIMIT_IP=60
UPLOAD_RATE_LIMIT_ACCOUNT=30

# Megabytes one account may upload during the UTC day.
UPLOAD_DAILY_MB_ACCOUNT=500

# Per-IP requests each minute on submit, marker, track, popup-view,
# topic-follow, and the GET routes that write or poll the mirror
# (post, messages, local, stream, user-settings, following). Also covers
# /api/turn and upload auth.
PUBLIC_POST_RATE_LIMIT=60

# Cloudflare Turnstile secret. Leave empty to skip the check. The public
# site key is VITE_TURNSTILE_SITE_KEY in the repository root .env.
TURNSTILE_SECRET_KEY=

# Set to 1 to require a wallet signature before /api/upload. The account
# used for the caps then comes from the token, not the X-Account header.
# The browser copy of this switch is VITE_REQUIRE_UPLOAD_AUTH in the root .env.
REQUIRE_UPLOAD_AUTH=

# HMAC secret for the 15-minute upload token. Required when auth is on.
# At least 32 bytes. A shorter value leaves upload auth disabled.
# Use a long random string. Do not put this in a VITE_ variable.
UPLOAD_TOKEN_SECRET=

# Bucket CORS origins, comma-separated. Default is any origin.
R2_CORS_ORIGINS=*

# Metered TURN. Both stay empty to leave peer connections without ICE servers.
# METERED_TURN_URL is the credentials endpoint with no query string, for
# example https://<your-app>.metered.live/api/v1/turn/credentials
METERED_TURN_URL=
METERED_API_KEY=
