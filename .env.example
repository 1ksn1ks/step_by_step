# Hedera Globe environment.
#
# The API reads server/.env (start it from the server folder, or let Railway
# inject the same names). Vite reads this file, and only names that start
# with VITE_ are sent to the browser. A VITE_ name containing R2_, SECRET,
# ACCESS_KEY, PRIVATE, API_KEY, TOKEN, or PASSWORD fails the production build.
#
# Leave a value empty to keep the safe default. Do not commit a filled .env.

# Public Turnstile site key. Empty skips the widget. The matching secret is
# TURNSTILE_SECRET_KEY in server/.env, not here.
VITE_TURNSTILE_SITE_KEY=

# Set to 1 so an upload asks the connected wallet to sign a nonce. The
# server must also set REQUIRE_UPLOAD_AUTH=1. Default off.
VITE_REQUIRE_UPLOAD_AUTH=

# The names below are server settings. They are listed here so every new
# knob is in one checklist. Copy them to server/.env. They do nothing in
# this file unless the process that starts the API loads it.

# Reverse-proxy hops. Default 1 (Railway). 0 keeps the socket address.
TRUST_PROXY=1

# Set to 1 to trust CF-Connecting-IP. Leave empty to ignore it.
TRUST_CF_IP=

# In-memory uploads at once. Further uploads get 503 and Retry-After.
UPLOAD_MAX_CONCURRENT=4

# Uploads from one IP at once. A few slow uploads cannot fill every slot.
UPLOAD_MAX_CONCURRENT_PER_IP=2

# Milliseconds a stalled upload body may sit idle before 408.
UPLOAD_BODY_TIMEOUT_MS=30000

# Per IP each minute on POST /api/upload, checked before Turnstile.
UPLOAD_REQUESTS_PER_MIN=30

# Upload caps: per IP each hour, per account each hour, megabytes per account per UTC day.
UPLOAD_RATE_LIMIT_IP=60
UPLOAD_RATE_LIMIT_ACCOUNT=30
UPLOAD_DAILY_MB_ACCOUNT=500

# Per IP each minute on the public post and mirror routes, plus /api/turn,
# /api/stream, /api/user-settings, and /api/following.
PUBLIC_POST_RATE_LIMIT=60

# Turnstile secret. Empty skips the check.
TURNSTILE_SECRET_KEY=

# Wallet-signed upload auth. Off unless this is 1. Needs UPLOAD_TOKEN_SECRET
# of at least 32 bytes. A shorter secret leaves upload auth disabled.
REQUIRE_UPLOAD_AUTH=
UPLOAD_TOKEN_SECRET=

# Bucket CORS origins, comma-separated. Default any origin.
R2_CORS_ORIGINS=*

# Metered TURN credentials URL (no query) and its API key. Both empty skips ICE.
METERED_TURN_URL=
METERED_API_KEY=
